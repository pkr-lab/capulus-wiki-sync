#!/usr/bin/env bash
set -euo pipefail

types="feat fix docs chore refactor test ci build perf style revert"
max_length=120
header="$(head -n 1 "$1")"
pattern="^(${types// /|})(\([a-z0-9_./,-]+\))?!?: .+"

case "$header" in
  Merge\ * | Revert\ * | fixup!\ * | squash!\ *) exit 0 ;;
esac

fail() {
  echo "$1" >&2
  echo "  $header" >&2
  echo "Erwartet: <typ>(<scope>)!: <beschreibung>, Typen: $types" >&2
  exit 1
}

if [[ ! "$header" =~ $pattern ]]; then
  fail "Commit-Nachricht entspricht nicht Conventional Commits:"
fi
if [[ "$header" == *. ]]; then
  fail "Die Beschreibung darf nicht mit einem Punkt enden:"
fi
if (( ${#header} > max_length )); then
  fail "Die Kopfzeile ist länger als $max_length Zeichen:"
fi
